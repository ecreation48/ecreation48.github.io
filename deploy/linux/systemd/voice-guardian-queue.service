[Unit]
Description=Voice Guardian Laravel queue worker
After=network-online.target redis-server.service postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=voiceguardian
Group=www-data
WorkingDirectory=/opt/voice-guardian/apps/web
ExecStart=/usr/bin/php artisan queue:work redis --sleep=2 --tries=3 --timeout=300
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
